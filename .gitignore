# session scratch (Claude Code scratchpad; never tracked)
/scratchpad/

# aeb build outputs
/target/

# the shared native sanitizer core is a build artifact (core/.build.ae rebuilds it)
/core/native/*.so
/core/native/*.dylib
/core/native/*.dll

# per-binding staged copies of the sanitizer core .so
**/native/*.so
**/native/*.dylib
**/native/*.dll

# per-language build artifacts
**/bin/
**/obj/
**/build/
**/.dart_tool/
**/dist-newstyle/
**/.stack-work/
**/vendor/
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/
**/dist/
**/node_modules/
**/_build/
**/deps/
**/zig-cache/
**/.zig-cache/
**/zig-out/
# gleam/.tests.ae runs `gleam deps download`, which regenerates this hex
# lockfile from the ranges in gleam.toml — a build artifact here, not source.
/gleam/manifest.toml
**/.nimcache/
**/nimcache/
# Nim compiles tests/tconformance.nim to a sibling binary of the same name
/nim/tests/tconformance
**/erl_crash.dump
**/.cpcache/
**/target/
*.class
*.o

# wasm build outputs (wasm/build.sh regenerates them)
/wasm/dist/
/wasm/build/
