// Named target set: everything that must be green before a push.
//
// A set's body only ever says no — it declares edges and nothing else. The
// engine nodes come first in spirit (aeb topo-sorts them first in fact,
// since every binding deps core/.build.ae).
//
// Bindings whose toolchain is absent skip loudly rather than failing, so this
// is meaningful on a partial toolchain set. Read target/.aeb/logs/<label>.log
// for per-node verdicts — aeb's exit status does not yet reflect leaf failure.

import bldr

aeb(cap) {
    bldr.build() {
        // meta.desc("engine + C ABI + every language binding")
        //
        // Parked, not deleted. The Shape A codemod rewrote this call site to
        // the b-free form, but lib/meta itself was NOT converted — it is the
        // only SDK lib still 100% explicit-ctx (17 fns taking `ctx: ptr`, 0
        // taking `_ctx: ptr`), so the call no longer type-checks:
        //     error[E0200]: Function 'meta.desc' expects 2 argument(s), got 1
        // Nothing in aeb calls meta.* either, so its own suite could not have
        // caught this. Only lib/brew reads the value back (for packaging),
        // which we do not use, so parking it costs nothing.
        // Filed as aeb/asks/lib-meta-missed-by-the-shape-a-sweep.md.
    
        // The engine and its two gates.
        dep("core_tests/.tests.ae")
        dep("core_tests/.abi.ae")
        dep("core_tests/.xss.ae")
        dep("core_tests/.ganss.ae")
        dep("core_tests/.normalize.ae")
        dep("core_tests/.baselines.ae")
    
        // Native-FFI bindings.
        dep("python/.tests.ae")
        dep("ruby/.tests.ae")
        dep("go/.tests.ae")
        dep("rust/.tests.ae")
        dep("java/.tests.ae")
        dep("javascript/.tests.ae")
        dep("dotnet/.tests.ae")
        dep("dart/.tests.ae")
        dep("php/.tests.ae")
        dep("lua/.tests.ae")
        dep("haskell/.tests.ae")
        dep("nim/.tests.ae")
        dep("zig/.tests.ae")
        dep("pharo/.tests.ae")
    
        // Browser target: recompiles the engine to wasm32 rather than loading the .so.
        dep("wasm/.tests.ae")
    
        // BEAM family — erlang owns the NIF; elixir and gleam share it.
        dep("erlang/.tests.ae")
        dep("elixir/.tests.ae")
        dep("gleam/.tests.ae")
    
        // JVM family — thin layers over the Java classes, no second FFI.
        dep("kotlin/.tests.ae")
        dep("scala/.tests.ae")
        dep("clojure/.tests.ae")
        dep("groovy/.tests.ae")
    
        return 0
    }
}
