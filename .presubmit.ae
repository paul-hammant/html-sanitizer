// Named target set: everything that must be green before a push.
//
// A set's body only ever says no — it declares edges and nothing else. The
// engine nodes come first in spirit (aeb topo-sorts them first in fact,
// since every binding deps core/.build.ae).
//
// Bindings whose toolchain is absent skip loudly rather than failing, so this
// is meaningful on a partial toolchain set. Read target/.aeb/logs/<label>.log
// for per-node verdicts — aeb's exit status does not yet reflect leaf failure.

import build
import meta

aeb(cap) {
    b = build.start()
    meta.desc(b, "engine + C ABI + every language binding")

    // The engine and its two gates.
    build.dep(b, "core_tests/.tests.ae")
    build.dep(b, "core_tests/.abi.ae")
    build.dep(b, "core_tests/.xss.ae")
    build.dep(b, "core_tests/.ganss.ae")
    build.dep(b, "core_tests/.normalize.ae")
    build.dep(b, "core_tests/.baselines.ae")

    // Native-FFI bindings.
    build.dep(b, "python/.tests.ae")
    build.dep(b, "ruby/.tests.ae")
    build.dep(b, "go/.tests.ae")
    build.dep(b, "rust/.tests.ae")
    build.dep(b, "java/.tests.ae")
    build.dep(b, "javascript/.tests.ae")
    build.dep(b, "dotnet/.tests.ae")
    build.dep(b, "dart/.tests.ae")
    build.dep(b, "php/.tests.ae")
    build.dep(b, "lua/.tests.ae")
    build.dep(b, "haskell/.tests.ae")
    build.dep(b, "nim/.tests.ae")
    build.dep(b, "zig/.tests.ae")
    build.dep(b, "pharo/.tests.ae")

    // Browser target: recompiles the engine to wasm32 rather than loading the .so.
    build.dep(b, "wasm/.tests.ae")

    // BEAM family — erlang owns the NIF; elixir and gleam share it.
    build.dep(b, "erlang/.tests.ae")
    build.dep(b, "elixir/.tests.ae")
    build.dep(b, "gleam/.tests.ae")

    // JVM family — thin layers over the Java classes, no second FFI.
    build.dep(b, "kotlin/.tests.ae")
    build.dep(b, "scala/.tests.ae")
    build.dep(b, "clojure/.tests.ae")
    build.dep(b, "groovy/.tests.ae")

    return 0
}
