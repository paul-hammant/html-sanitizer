# Pinned toolchain versions — the single place to bump.
#
# aeb tags are "later means later" markers, NOT semver promises; pin them so a
# run is reproducible. Override at the shell to test a bump
# (e.g. `AETHER_REF=v0.675.0 aeb .presubmit.ae`).

# ---- Aether engine toolchain ----

# The Aether compiler (`ae`). Tag vX.Y.Z, branch, or commit SHA.
# Pinned to 0.675.0. Floor is 0.670.0 — aeb v0.311's SDK calls fs.make_temp_file
# / fs.remove_tree (stdlib symbols first shipped in ae 0.670), so the fan-out
# orchestrator link needs an ae whose libaether.a defines fs_make_temp_file_raw.
#
# INSTALL AS A CONSISTENT SET. `ae version use` updates ~/.aether/current, but a
# raw get.sh into ~/.local can leave ~/.local/bin/ae at 0.675 next to a STALE
# ~/.local/lib/aether/libaether.a — the driver reports 0.675 while the archive
# predates fs_make_temp_file_raw, and the orchestrator link dies with
# "undefined reference to fs_make_temp_file_raw". Ensure ~/.local/lib/aether/
# libaether.a matches the driver (get.sh's normal install does; a half-updated
# tree is the trap).
AETHER_REF=v0.675.0

# The aeb build runner. Tag v0.NNN, branch, or commit SHA.
# v0.311. NOTE: the literal v0.311 TAG is broken — its _dir_newest_mtime helper
# fails ae 0.675's E0200 narrowing check (32-bit `newest = 0` accumulators).
# Fixed 3 commits past the tag (aeb 1415206, "long newest = 0"); build from the
# aeb main tip at/after v0.311-4-g8a35327, not the bare tag. Carries the v0.298
# make-free installer and the v0.287 exit-code fix (aeb exits 1 on a failed leaf,
# so bootstrap.sh trusts the exit status).
AEB_REF=v0.311

# ---- BEAM family (erlang, elixir, gleam bindings) ----
#
# Floor is OTP 27 + Elixir 1.20. OTP 25 (Debian bookworm's package) is too old:
# gleam_stdlib fails to compile under it (escript rejects `~` bitstring syntax),
# and Elixir 1.16.3's parser rejects test source that 1.20 accepts. OTP 27 +
# Elixir 1.20.4 build and pass all three BEAM bindings.
OTP_REF=27
ELIXIR_REF=1.20.4

# ---- Other language toolchains (floors the bindings assume) ----
# JVM family (java/kotlin/scala/clojure/groovy): JDK 22+ (skip_below_jdk(22));
#   kotlin needs KOTLIN_HOME at a 2.x SDK (Debian's 1.3.31 can't read JDK 22+
#   bytecode). Verified on JDK 24 + Kotlin 2.4.0.
# node 18+, go 1.22+ — as the respective .tests.ae prereqs declare.
