# Pinned toolchain versions — the single place to bump.
#
# aeb tags are "later means later" markers, NOT semver promises; pin them so a
# run is reproducible. Override at the shell to test a bump
# (e.g. `AETHER_REF=v0.897.0 aeb .presubmit.ae`).

# ---- Aether toolchain ----

# The Aether compiler (`ae`). Tag vX.Y.Z, branch, or commit SHA.
# Pinned to 0.897.0 — verified 2026-11-07 (macOS arm64 + cachyos x86_64):
# core_tests (all six gates) and the zig, go, javascript and wasm bindings,
# plus the rest listed in the commit that moved this pin. 0.897.0 is also the
# floor: nothing between 0.706.0 and it was tested. What the sanitizer core
# needs from a newer ae, for whoever wants to lower it with evidence:
#   - closure envs that start with {_dtor, _refs} and are retained/released
#     around every `unbox_closure` call site (aether #2494, 0.792.0) —
#     core/_embed_support.c's HsCb mirrors that header by hand;
#   - the `@keep` / `@into` ptr-parameter annotations (E0902) in
#     core/htmlsanitizer.ae;
#   - `--emit=lib` refusing externs without `--with=extern` (core/.build.ae
#     passes caps("extern")).
# Install as a consistent set — a get.sh binary install pairs the driver with
# a matching libaether.a; a half-updated ~/.local (new driver, stale
# libaether.a) fails the fan-out link.
AETHER_REF=v0.897.0

# The aeb build runner. Tag v0.NNN, branch, or commit SHA.
# v0.341 — the current release, verified with ae 0.897.0 on the same runs as
# above. Still gh-release, prebuilt per-platform binaries, binary-first via
# get.sh, and exits 1 on a failed leaf (the v0.287 fix bootstrap.sh relies on).
AEB_REF=v0.341

# ---- BEAM family (erlang, elixir, gleam bindings) ----
#
# Floor is OTP 27 + Elixir 1.20. OTP 25 (Debian bookworm's package) is too old:
# gleam_stdlib fails to compile under it (escript rejects `~` bitstring syntax),
# and Elixir 1.16.3's parser rejects test source that 1.20 accepts. OTP 27 +
# Elixir 1.20.4 build and pass all three BEAM bindings.
OTP_REF=27
ELIXIR_REF=1.20.4

# ---- Other language toolchains (floors the bindings assume) ----
# JVM family (java/kotlin/scala/clojure/groovy): JDK 22+ (skip_below_jdk(22));
#   kotlin needs KOTLIN_HOME at a 2.x SDK (Debian's 1.3.31 can't read JDK 22+
#   bytecode). Verified on JDK 24 + Kotlin 2.4.0.
# node 18+, go 1.22+ — as the respective .tests.ae prereqs declare.
