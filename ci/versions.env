# Pinned toolchain versions — the single place to bump.
#
# aeb tags are "later means later" markers, NOT semver promises; pin them so a
# run is reproducible. Override at the shell to test a bump
# (e.g. `# 0.935.0 (2026-11-22): a TRACKING bump again, no new primitive needed and no source
# change. Verified on the released 0.935.0, macOS arm64 (aeb main as the runner): core build,
# core_tests .tests, .abi and .xss gates all exit 0. The bindings were not re-run.
AETHER_REF=v0.935.0 aeb .presubmit.ae`).

# ---- Aether toolchain ----

# The Aether compiler (`ae`). Tag vX.Y.Z, branch, or commit SHA.
# Pinned to 0.908.0 — a tracking-only bump from 0.897.0 (no new primitive needed),
# verified 2026-11-11 on cachyos x86_64 with a clean-prefix get.sh install: all six
# core_tests gates and 24 of 26 bindings, details in the commit. Earlier 0.897.0 check
# (2026-11-07, macOS arm64 + cachyos x86_64):
# core_tests (all six gates) and the zig, go, javascript and wasm bindings,
# plus the rest listed in the commit that moved this pin. 0.897.0 is the real
# floor (the primitives below); nothing between 0.706.0 and it was tested. What the sanitizer core
# needs from a newer ae, for whoever wants to lower it with evidence:
#   - closure envs that start with {_dtor, _refs} and are retained/released
#     around every `unbox_closure` call site (aether #2494, 0.792.0) —
#     core/_embed_support.c's HsCb mirrors that header by hand;
#   - the `@keep` / `@into` ptr-parameter annotations (E0902) in
#     core/htmlsanitizer.ae;
#   - `--emit=lib` refusing externs without `--with=extern` (core/.build.ae
#     passes caps("extern")).
# Install as a consistent set — a get.sh binary install pairs the driver with
# a matching libaether.a; a half-updated ~/.local (new driver, stale
# libaether.a) fails the fan-out link.
#
# 0.931.0 (2026-11-20): a TRACKING bump from 0.908.0, no new primitive needed
# (0.897.0 stays the real floor above). The one source change it forced,
# E0202 in removal_reason (a ptr given to a string parameter, refused since
# 0.927.0), landed as 2f5f5ee. Verified on the released 0.931.0, Linux x86_64
# (cachyos): core, all six core_tests gates, and the bindings python, ruby, go,
# rust, java, javascript, dotnet, dart, lua, haskell, nim, zig, wasm, erlang,
# elixir, gleam, kotlin, clojure and groovy; pharo skips (no Pharo VM), scala
# skips (no scalac). php ran on cachyos with `php -d extension=ffi` (the ffi
# extension is installed but not enabled in php.ini; the test invocation
# enabled it per run, nothing system-wide). Re-verified on the tagged aeb v0.348.
# The java, kotlin, scala, clojure and groovy tests accept the multi-line
# classpath artifact aeb hands them.
# 0.933.0 (2026-11-21): a TRACKING bump again, no new primitive needed and no source
# change (0.897.0 stays the real floor). Verified on the released 0.933.0, Linux
# x86_64 (ae-x64, aeb v0.349 as the runner): core build, core_tests .tests, .abi and
# .xss gates all exit 0. The bindings were not re-run.
AETHER_REF=v0.933.0

# The aeb build runner. Tag v0.NNN, branch, or commit SHA.
# v0.348 — the current release, and a FLOOR MOVE (from v0.344): aeb v0.344's own
# tools (for example tools/scan-ae-files.ae) no longer compile on ae 0.931.0
# (E0202), so no older aeb runs here. v0.347 (the first that does) was verified
# first; v0.348 is the tagged release installed with get.sh and verified on
# the leaves listed above. (v0.344 was verified with ae 0.908.0.) Still gh-release,
# prebuilt per-platform binaries, binary-first via get.sh, and exits 1 on a
# failed leaf (the v0.287 fix bootstrap.sh relies on).
#
# Known aeb defect, worked around here and written up as
# asks/aeb-java-classpath-artifact-grows-on-rerun.md: re-running a java.javac
# node in the same target/ appends the classes dir again to its
# jvm_classpath_deps_including_transitive artifact, so the artifact is several
# lines. The java, kotlin, scala, clojure and groovy tests turn the lines into
# one colon-separated classpath.
AEB_REF=v0.348

# ---- BEAM family (erlang, elixir, gleam bindings) ----
#
# Floor is OTP 27 + Elixir 1.20. OTP 25 (Debian bookworm's package) is too old:
# gleam_stdlib fails to compile under it (escript rejects `~` bitstring syntax),
# and Elixir 1.16.3's parser rejects test source that 1.20 accepts. OTP 27 +
# Elixir 1.20.4 build and pass all three BEAM bindings.
OTP_REF=27
ELIXIR_REF=1.20.4

# ---- Other language toolchains (floors the bindings assume) ----
# JVM family (java/kotlin/scala/clojure/groovy): JDK 22+ (skip_below_jdk(22));
#   kotlin needs KOTLIN_HOME at a 2.x SDK (Debian's 1.3.31 can't read JDK 22+
#   bytecode). Verified on JDK 24 + Kotlin 2.4.0.
# node 18+, go 1.22+ — as the respective .tests.ae prereqs declare.
