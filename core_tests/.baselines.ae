// Baselines: named sanitization targets (email-safe being the first).
//
// A baseline names the OUTCOME a caller wants — "safe to put in an email" —
// rather than making them assemble it from forty setters. It narrows the
// default policy; it never widens it.

import bldr
import std.os

aeb(cap) {
    bldr.build() {
        root = _get("root")
        out = "${root}/target/baselines"
    
        _m = os.system("mkdir -p \"${root}/target\"")
    
        rc = os.system("cd \"${root}\" && ae build core_tests/baselines.ae -o \"${out}\"")
        if rc != 0 {
            println("core_tests: failed to build baselines.ae")
            return 1
        }
        rc2 = os.system("\"${out}\"")
        if rc2 != 0 {
            println("core_tests: baseline suite reported failures")
            return 1
        }
        println("core_tests: PASS — baselines (email-safe)")
        return 0
    }
}
