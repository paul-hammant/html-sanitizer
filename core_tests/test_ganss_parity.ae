// Parity suite: Michael Ganss's C# HtmlSanitizer tests, ported to std.spec.
//
// GENERATED — do not hand-edit. Regenerate with the porter in the repo's
// tooling (see docs/ganss-parity.md), which reads
// ../HtmlSanitizer/test/HtmlSanitizer.Tests/Tests.cs and translates every
// test whose whole body it understands.
//
// Why generate rather than hand-port: upstream has 252 [Fact]s + 18
// [Theory]s encoding a decade of XSS bypass reports. Hand-copying them
// invites transcription errors in exactly the strings where a wrong byte
// silently weakens a security test.
//
// The porter is deliberately CONSERVATIVE. A test is emitted only when its
// input, its configuration and its expectation are all resolvable to
// literals; anything else is skipped WITH A REASON rather than guessed at,
// so this file can never claim coverage it does not have. The skip manifest
// (count and reasons) is in docs/ganss-parity.md.
//
// Portions copyright (c) 2013-2016 Michael Ganss and the original C#
// HtmlSanitizer contributors (MIT) — these test vectors are theirs.

import core.htmlsanitizer
import core.htmlsanitizer (HtmlSanitizer)
import std.spec
import std.set
import std.string
import std.regex

// Case-insensitive compare, for the upstream asserts that pass
// `ignoreCase: true`. Those tests care about the sanitizing decision, not
// the emitter's tag/attribute casing.
fn eq_ci(actual: string, expected: string) -> bool {
    return string.to_lower(actual) == string.to_lower(expected)
}

main() {
    fw = spec.init()
    spec.describe(fw, "Ganss C# HtmlSanitizer parity") {
        spec.it("XssLocatorTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<a href=\"'';!--\"<XSS>=&{()}\">", "")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<a href=\"'';!--\">=&amp;{()}\"&gt;</a>"),
                "XssLocatorTest (case-insensitive)")
            htmlsanitizer.free(s)
        }
        spec.it("ImageXss1Test") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<IMG SRC=\"javascript:alert('XSS');\">", "")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<img>"),
                "ImageXss1Test (case-insensitive)")
            htmlsanitizer.free(s)
        }
        spec.it("ImageXss2Test") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<IMG SRC=javascript:alert('XSS')>", "")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<IMG>"),
                "ImageXss2Test (case-insensitive)")
            htmlsanitizer.free(s)
        }
        spec.it("ImageCaseInsensitiveXssTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<IMG SRC=JaVaScRiPt:alert('XSS')>", "")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<IMG>"),
                "ImageCaseInsensitiveXssTest (case-insensitive)")
            htmlsanitizer.free(s)
        }
        spec.it("ImageHtmlEntitiesXssTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<IMG SRC=javascript:alert(&quot;XSS&quot;)>", "")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<IMG>"),
                "ImageHtmlEntitiesXssTest (case-insensitive)")
            htmlsanitizer.free(s)
        }
        spec.it("ImageGraveAccentXssTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<IMG SRC=`javascript:alert(\"RSnake says, 'XSS'\")`>", "")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<img>"),
                "ImageGraveAccentXssTest (case-insensitive)")
            htmlsanitizer.free(s)
        }
        spec.it("ImageMalformedXssTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<IMG \"\"\"><SCRIPT>alert(\"XSS\")</SCRIPT>\">", "")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<img>\"&gt;"),
                "ImageMalformedXssTest (case-insensitive)")
            htmlsanitizer.free(s)
        }
        spec.it("ImageFromCharCodeXssTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<IMG SRC=javascript:alert(String.fromCharCode(88,83,83))>", "")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<img>"),
                "ImageFromCharCodeXssTest (case-insensitive)")
            htmlsanitizer.free(s)
        }
        spec.it("ImageUTF8UnicodeXssTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<IMG SRC=&#106;&#97;&#118;&#97;&#115;&#99;&#114;&#105;&#112;&#116;&#58;&#97;&#108;&#101;&#114;&#116;&#40;&#39;&#88;&#83;&#83;&#39;&#41;>", "")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<img>"),
