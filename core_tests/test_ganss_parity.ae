            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<div style=\"width: calc((600px - 300px) / 2)\">Test</div>", "")
            spec.assert_str_eq(actual, "<div style=\"width: calc((600px - 300px) / 2)\">Test</div>", "Number263Test")
            htmlsanitizer.free(s)
        }
