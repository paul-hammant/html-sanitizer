            actual = htmlsanitizer.sanitize(s, "<div>Hallo <p><b>Bold<br>Ballo", "")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<div>Hallo <p><b>Bold<br>Ballo</b></p></div>"),
                "SanitizeNonClosedTagTest (case-insensitive)")
            htmlsanitizer.free(s)
        }
        spec.it("DisallowCssPropertyValueTest") callback {
            s = htmlsanitizer.new()
            rx, _rxe = regex.compile("^rgba\\(0.*")
            s.disallow_css_property_value_regex = rx
            actual = htmlsanitizer.sanitize(s, "<div style=\"color: rgba(0, 0, 0, 1); background-color: rgba(255, 255, 255, 1)\">Test</div>", "")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<div style=\"background-color: rgba(255, 255, 255, 1)\">Test</div>"),
                "DisallowCssPropertyValueTest (case-insensitive)")
            htmlsanitizer.free(s)
        }
        spec.it("CssKeyTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<div style=\"\\000062ackground-image: URL(http://www.example.com/bg.jpg)\">Test</div>", "")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<div style=\"background-image: url(&quot;http://www.example.com/bg.jpg&quot;)\">Test</div>"),
                "CssKeyTest (case-insensitive)")
            htmlsanitizer.free(s)
        }
        spec.it("InvalidBaseUrlTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<div style=\"color: rgba(0, 0, 0, 1); background-image: URL(x/y/bg.jpg)\">Test</div>", "hallo")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<div style=\"color: rgba(0, 0, 0, 1)\">Test</div>"),
                "InvalidBaseUrlTest (case-insensitive)")
            htmlsanitizer.free(s)
        }
        spec.it("QuotedBackgroundImageTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<div style=\"background-image: url('some/random/url.img')\"></div>", "")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<div style=\"background-image: url(&quot;some/random/url.img&quot;)\"></div>"),
                "QuotedBackgroundImageTest (case-insensitive)")
            htmlsanitizer.free(s)
        }
        spec.it("QuotedBackgroundImageFromIE9") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<span style='background-image: url(\"/api/users/defaultAvatar\");'></span>", "")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<span style=\"background-image: url(&quot;/api/users/defaultAvatar&quot;)\"></span>"),
                "QuotedBackgroundImageFromIE9 (case-insensitive)")
            htmlsanitizer.free(s)
        }
        spec.it("DocumentTest") callback {
            s = htmlsanitizer.new()
            set.add(s.allowed_tags, "title")
            actual = htmlsanitizer.sanitize_document(s, "<html><head><title>Test</title></head><body><div>Test</div></body></html>", "")
            spec.assert_str_eq(actual, "<html><head><title>Test</title></head><body><div>Test</div></body></html>", "DocumentTest")
            htmlsanitizer.free(s)
        }
        spec.it("DocumentFromFragmentTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize_document(s, "<div>Test</div>", "")
            spec.assert_str_eq(actual, "<html><head></head><body><div>Test</div></body></html>", "DocumentFromFragmentTest")
            htmlsanitizer.free(s)
        }
        spec.it("FragmentFromDocumentTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<html><head><title>Test</title></head><body><div>Test</div></body></html>", "")
            spec.assert_str_eq(actual, "<div>Test</div>", "FragmentFromDocumentTest")
            htmlsanitizer.free(s)
        }
        spec.it("StyleTagTest") callback {
            s = htmlsanitizer.new()
            set.add(s.allowed_tags, "style")
            actual = htmlsanitizer.sanitize_document(s, "<html><head><style>body { background-color: rgba(255, 255, 255, 1); hallo-ballo: xyz }</style></head><body><div>Test</div></body></html>", "")
            spec.assert_str_eq(actual, "<html><head><style>body { background-color: rgba(255, 255, 255, 1) }</style></head><body><div>Test</div></body></html>", "StyleTagTest")
            htmlsanitizer.free(s)
        }
        spec.it("UriHashTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<a href=\"http://domain.com/index.html?test=#value#\">test</a>", "")
            spec.assert_str_eq(actual, "<a href=\"http://domain.com/index.html?test=#value#\">test</a>", "UriHashTest")
            htmlsanitizer.free(s)
        }
        spec.it("FragmentTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<script>alert('test');</script><p>Test</p>", "")
            spec.assert_str_eq(actual, "<p>Test</p>", "FragmentTest")
            htmlsanitizer.free(s)
        }
        spec.it("OpenTagFragmentTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<p>abc<script>xyz</p>", "")
            spec.assert_str_eq(actual, "<p>abc</p>", "OpenTagFragmentTest")
            htmlsanitizer.free(s)
        }
        spec.it("NullStyleTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<p style=\"t\">xyz</p>", "")
            spec.assert_str_eq(actual, "<p>xyz</p>", "NullStyleTest")
            htmlsanitizer.free(s)
        }
        spec.it("EscapeEntityInAttributeValueTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize(s, "<input type=\"text\" name=\"my_name\" value=\"<insert name>\">", "")
            spec.assert_str_eq(actual, "<input type=\"text\" name=\"my_name\" value=\"&lt;insert name&gt;\">", "EscapeEntityInAttributeValueTest")
            htmlsanitizer.free(s)
        }
        spec.it("FontFaceTest") callback {
            s = htmlsanitizer.new()
            s.allow_data_attributes = true
            set.add(s.allowed_tags, "style")
            set.add(s.allowed_css_properties, "src")
            set.add(s.allowed_css_properties, "font-family")
            actual = htmlsanitizer.sanitize_document(s, "<html><head><style>@font-face { font-family: FrutigerLTStd; src: url(\"https://example.com/FrutigerLTStd-Light.otf\") format(\"opentype\") }</style></head><body></body></html>", "")
            spec.assert_str_eq(actual, "<html><head><style>@font-face { font-family: FrutigerLTStd; src: url(\"https://example.com/FrutigerLTStd-Light.otf\") format(\"opentype\") }</style></head><body></body></html>", "FontFaceTest")
            htmlsanitizer.free(s)
        }
        spec.it("KeepChildNodesTest") callback {
            s = htmlsanitizer.new()
            set.remove(s.allowed_tags, "div")
            actual = htmlsanitizer.sanitize(s, "Test1 <div>Test2 <script>Test3</script> <b>Test4</b></div>", "")
            spec.assert_str_eq(actual, "Test1 Test2 Test3 <b>Test4</b>", "KeepChildNodesTest")
            htmlsanitizer.free(s)
        }
        spec.it("TrailingSlashTest") callback {
            s = htmlsanitizer.new()
            set.add(s.allowed_schemes, "resources")
            actual = htmlsanitizer.sanitize(s, "<IMG src=\"resources://ais_w20_h20_33ba129c.png\">", "")
            spec.assert_str_eq(string.to_lower(actual), string.to_lower("<IMG src=\"resources://ais_w20_h20_33ba129c.png\">"),
                "TrailingSlashTest (case-insensitive)")
            htmlsanitizer.free(s)
        }
        spec.it("FileUrlTest") callback {
            s = htmlsanitizer.new()
            set.add(s.allowed_schemes, "file")
            actual = htmlsanitizer.sanitize(s, "<a href=\"file:///C:/exampleㄓ.txt\">test</a>", "")
            spec.assert_str_eq(actual, "<a href=\"file:///C:/exampleㄓ.txt\">test</a>", "FileUrlTest")
            htmlsanitizer.free(s)
        }
        spec.it("SvgTest") callback {
            s = htmlsanitizer.new()
            set.add(s.allowed_tags, "svg")
            actual = htmlsanitizer.sanitize(s, "<svg onchange='alert(1)'>123</svg>", "")
            spec.assert_str_eq(actual, "<svg>123</svg>", "SvgTest")
            htmlsanitizer.free(s)
        }
        spec.it("SquareBracketTest") callback {
            s = htmlsanitizer.new()
            set.add(s.allowed_attributes, "[minutes]")
            actual = htmlsanitizer.sanitize(s, "<div [minutes]=\"2\">123</div>", "")
            spec.assert_str_eq(actual, "<div [minutes]=\"2\">123</div>", "SquareBracketTest")
            htmlsanitizer.free(s)
        }
        spec.it("HtmlDocumentTest") callback {
            s = htmlsanitizer.new()
            actual = htmlsanitizer.sanitize_document(s, "<html onmousemove=\"alert(document.location)\"><head></head><body></body></html>", "")
            spec.assert_str_eq(actual, "<html><head></head><body></body></html>", "HtmlDocumentTest")
            htmlsanitizer.free(s)
        }
        spec.it("StyleByPassTest") callback {
            s = htmlsanitizer.new()
            set.add(s.allowed_tags, "style")
            actual = htmlsanitizer.sanitize(s, "aaabc<style>x[x='\\3c /style>\\3c img src onerror=alert(1)>']{}</style>", "http://www.example.com")
            spec.assert_str_eq(actual, "aaabc<style>x[x=\"\\3c /style>\\3c img src onerror=alert(1)>\"] { }</style>", "StyleByPassTest")
            htmlsanitizer.free(s)
        }
