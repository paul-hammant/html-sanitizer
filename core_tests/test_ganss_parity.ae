            set.add(s.allowed_tags, "svg")
            set.add(s.allowed_tags, "title")
            set.add(s.allowed_tags, "xmp")
            actual = htmlsanitizer.sanitize(s, "<svg></p><title><xmp></title><img src=x onerror=alert(1)></xmp></title>", "https://www.example.com")
            spec.assert_str_eq(actual, "<svg></svg><p></p><title>&lt;xmp&gt;</title><img src=\"https://www.example.com/x\">", "BypassTest")
            htmlsanitizer.free(s)
