            spec.assert_str_eq(actual, "<div style=\"height: 0; background-image: url(&quot;https://example.com/1.jpg&quot;), url(&quot;https://example.com/2.jpg&quot;), url(&quot;https://example.com/3.jpg&quot;); display: none\"></div>", "Number469Test")
