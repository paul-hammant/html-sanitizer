            actual = htmlsanitizer.sanitize(s, "<img srcset=\"a.jpg 1x, b.jpg 2x\">", "https://www.example.com/")
            spec.assert_str_eq(actual, "<img srcset=\"https://www.example.com/a.jpg 1x, https://www.example.com/b.jpg 2x\">", "SanitizeUriListResolvesRelativeUrlsAgainstBaseUrlTest")
            htmlsanitizer.free(s)
        }
