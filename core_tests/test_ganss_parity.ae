        spec.it("Bypass2Test") callback {
            s = htmlsanitizer.new()
            set.add(s.allowed_tags, "form")
            set.add(s.allowed_tags, "math")
            set.add(s.allowed_tags, "mtext")
            set.add(s.allowed_tags, "mglyph")
            set.add(s.allowed_tags, "xmp")
            actual = htmlsanitizer.sanitize(s, "<form><math><mtext></form><form><mglyph><xmp></math><img src onerror=alert(1)>", "https://www.example.com")
            spec.assert_str_eq(actual, "<form><math><mtext><form><mglyph><xmp>&lt;/math&gt;&lt;img src onerror=alert(1)&gt;</xmp></mglyph></form></mtext></math></form>", "Bypass2Test")
            htmlsanitizer.free(s)
        }
