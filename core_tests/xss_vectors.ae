// XSS bypass-vector regression suite for the engine.
//
// core_tests/probe.ae proves the API behaves as the C# library does. This
// file asks the different question a security library actually has to answer:
// does a known evasion technique get through?
//
// Each case is a technique, not a payload — case-variation, entity encoding,
// CSS escapes, protocol tricks, malformed markup, nesting. A failure here is a
// live XSS hole, so treat any regression as urgent rather than cosmetic.
//
// The assertion style is deliberately coarse: rather than pin exact output
// (which couples the test to formatting), each case asserts that the
// DANGEROUS SUBSTRING is absent from the result. That keeps the suite honest
// when the emitter changes and makes each failure legible.

import core.htmlsanitizer
import core.htmlsanitizer (HtmlSanitizer)
import std.string
import std.set

extern exit(code: int)

// Aether has no top-level mutable globals, so each check RETURNS its failure
// count (0 or 1) and main sums them. Verbose at the call site, but it keeps
// the suite a plain data-in/verdict-out list with no hidden state.

fn report(name: string, html: string, got: string, forbidden: string) -> int {
    if string.contains(got, forbidden) == 1 {
        println("  FAIL ${name}")
        println("    input:     ${html}")
        println("    output:    ${got}")
        println("    contained: ${forbidden}")
        return 1
    }
    println("  PASS ${name}")
    return 0
}

// Assert the sanitized output does NOT contain `forbidden`.
fn deny(s: ptr, name: string, html: string, forbidden: string) -> int {
    got = htmlsanitizer.sanitize(s, html, "")
    return report(name, html, got, forbidden)
}

// Assert the sanitized output DOES contain `required` — the counter-check to
// deny(). A sanitizer that strips everything passes every deny() test; these
// are what stop a fix from over-blocking.
fn keep(s: ptr, name: string, html: string, required: string) -> int {
    got = htmlsanitizer.sanitize(s, html, "")
    if string.contains(got, required) == 1 {
        println("  PASS ${name}")
        return 0
    }
    println("  FAIL ${name}")
    println("    input:   ${html}")
    println("    output:  ${got}")
    println("    missing: ${required}")
    return 1
}

// Same, with a base URL in play (URL resolution changes the path taken).
fn deny_based(s: ptr, name: string, html: string, base: string, forbidden: string) -> int {
    got = htmlsanitizer.sanitize(s, html, base)
    return report(name, html, got, forbidden)
}

main() {
    println("=== XSS bypass-vector suite ===")
    s = htmlsanitizer.new()
    f = 0

    // ---- script injection, direct and obfuscated ----
    f = f + deny(s, "plain script tag", "<script>alert(1)</script>", "alert")
    f = f + deny(s, "uppercase script tag", "<SCRIPT>alert(1)</SCRIPT>", "alert")
    f = f + deny(s, "mixed-case script tag", "<ScRiPt>alert(1)</ScRiPt>", "alert")
    f = f + deny(s, "script with attribute", "<script type=\"text/javascript\">alert(1)</script>", "alert")
    f = f + deny(s, "unclosed script tag", "<script>alert(1)", "alert")
    f = f + deny(s, "nested script tags", "<script><script>alert(1)</script></script>", "alert")
    f = f + deny(s, "script split by comment", "<scr<!-- -->ipt>alert(1)</script>", "alert(1)</script>")

    // ---- event handlers ----
    f = f + deny(s, "onerror on img", "<img src=x onerror=alert(1)>", "onerror")
    f = f + deny(s, "onload on body", "<body onload=alert(1)>", "onload")
    f = f + deny(s, "onclick on div", "<div onclick=\"alert(1)\">x</div>", "onclick")
    f = f + deny(s, "onmouseover", "<a onmouseover=\"alert(1)\">x</a>", "onmouseover")
    f = f + deny(s, "uppercase ONERROR", "<img src=x ONERROR=alert(1)>", "alert")
    f = f + deny(s, "split event-handler name", "<img src=x on error=alert(1)>", "onerror")
    f = f + deny(s, "onfocus autofocus", "<input onfocus=alert(1) autofocus>", "onfocus")

    // ---- javascript: and other dangerous schemes ----
    f = f + deny(s, "javascript: href", "<a href=\"javascript:alert(1)\">x</a>", "javascript:")
    f = f + deny(s, "JaVaScRiPt: href", "<a href=\"JaVaScRiPt:alert(1)\">x</a>", "alert")
    f = f + deny(s, "javascript: with spaces", "<a href=\" javascript:alert(1)\">x</a>", "javascript:")
    f = f + deny(s, "javascript: with embedded space", "<a href=\"java script:alert(1)\">x</a>", "javascript:")
    f = f + deny(s, "vbscript: href", "<a href=\"vbscript:msgbox(1)\">x</a>", "vbscript:")
    f = f + deny(s, "data: URI in href", "<a href=\"data:text/html,<script>alert(1)</script>\">x</a>", "data:text/html")
    f = f + deny(s, "javascript: in img src", "<img src=\"javascript:alert(1)\">", "javascript:")
    f = f + deny(s, "javascript: in iframe src", "<iframe src=\"javascript:alert(1)\">", "javascript:")

    // ---- entity / numeric encoding evasion ----
    // &#106; is 'j' — the classic "&#106;avascript:" bypass.
    f = f + deny(s, "decimal-entity javascript:",
        "<a href=\"&#106;avascript:alert(1)\">x</a>", "alert")
    f = f + deny(s, "hex-entity javascript:",
        "<a href=\"&#x6a;avascript:alert(1)\">x</a>", "alert")
    f = f + deny(s, "long-form entity javascript:",
        "<a href=\"&#0000106;avascript:alert(1)\">x</a>", "alert")

    // ---- CSS-borne vectors ----
    // Was a known gap; now closed. css_value_is_unsafe() applies upstream's
    // two ALWAYS-ON checks (the CssExpression regex and the `[<>]` default of
    // DisallowCssPropertyValue) without needing PCRE2 — which matters because
    // regex is stubbed out in the --emit=lib builds.
    f = f + deny(s, "expression() in style",
        "<div style=\"width: expression(alert(1))\">x</div>", "expression")
    f = f + deny(s, "EXPRESSION uppercase",
        "<div style=\"width: EXPRESSION(alert(1))\">x</div>", "EXPRESSION")
    f = f + deny(s, "angle bracket in css value",
        "<div style=\"background-color: url(<script>)\">x</div>", "<script")

    // Counter-checks: ordinary CSS must survive the always-on value checks.
    // NB the colour is NORMALISED to rgba(...) — matching AngleSharp, which
    // upstream serializes through. Assert the colour survives, not its
    // spelling.
    f = f + keep(s, "hex colour kept", "<div style=\"color: #ff0000\">x</div>", "rgba(255, 0, 0, 1)")
    f = f + keep(s, "calc kept", "<div style=\"width: calc(100% - 10px)\">x</div>", "calc(")
    f = f + keep(s, "rgba kept", "<div style=\"color: rgba(1, 2, 3, 0.5)\">x</div>", "rgba(")
    f = f + deny(s, "javascript: in css url",
        "<div style=\"background-image: url(javascript:alert(1))\">x</div>", "javascript:")
    f = f + deny(s, "backslash-escaped css url",
        "<div style=\"background-image: \\75\\72\\6c(javascript:alert(1))\">x</div>", "alert")
    f = f + deny(s, "behavior property",
        "<div style=\"behavior: url(evil.htc)\">x</div>", "behavior")
    f = f + deny(s, "-moz-binding",
        "<div style=\"-moz-binding: url(evil.xml)\">x</div>", "-moz-binding")

    // ---- dangerous elements ----
    f = f + deny(s, "iframe", "<iframe src=\"//evil.example\"></iframe>", "iframe")
    f = f + deny(s, "object", "<object data=\"evil.swf\"></object>", "object")
    f = f + deny(s, "embed", "<embed src=\"evil.swf\">", "embed")
    // NB: <form>/<input> ARE in the upstream C# default allow-list, so their
    // presence is policy, not a bypass. What must hold is that a caller who
    // tightens the policy actually gets it — covered in main() below.
    f = f + deny(s, "meta refresh", "<meta http-equiv=\"refresh\" content=\"0;url=//evil\">", "http-equiv")
    f = f + deny(s, "base tag", "<base href=\"//evil.example/\">", "<base")
    f = f + deny(s, "link stylesheet", "<link rel=stylesheet href=\"//evil.example/x.css\">", "<link")
    f = f + deny(s, "svg script", "<svg><script>alert(1)</script></svg>", "alert")
    f = f + deny(s, "svg onload", "<svg onload=alert(1)>", "onload")

    // ---- malformed / parser-confusion markup ----
    f = f + deny(s, "unclosed img with handler", "<img src=x onerror=alert(1)", "alert")
    f = f + deny(s, "stray lt before script", "<<script>alert(1)</script>", "alert(1)</script>")
    f = f + deny(s, "NUL entity in tag name", "<scr&#0;ipt>alert(1)</script>", "alert(1)</script>")
    f = f + deny(s, "attribute without quotes", "<div onclick=alert(1)>x</div>", "onclick")
    // Escaped to inert text (&lt;&lt;...), which is correct — assert only
    // that it never becomes a live attribute.
    f = f + deny(s, "extra angle brackets", "<div><<>>onclick=alert(1)</div>", "<div onclick")
    f = f + deny(s, "cdata wrapped script", "<![CDATA[<script>alert(1)</script>]]>", "alert(1)</script>")

    // ---- malformed / unparseable scheme (the "" ambiguity) ----
    // get_scheme returns "" for BOTH a genuine relative URL and a value it
    // could not parse. Treating them alike let a grave-accent-wrapped payload
    // through: `javascript:` is not a parseable scheme, so it was waved past
    // the allow-list as if it were "/page.html". is_plain_relative() splits
    // the two — a colon before any /?# means the author wrote a SCHEME, and
    // one we cannot identify is refused rather than trusted.
    f = f + deny(s, "grave-accent wrapped javascript:",
        "<IMG SRC=`javascript:alert(1)`>", "javascript:")
    f = f + deny(s, "grave-accent in css url",
        "<div style=\"background-image: url(`javascript:alert(1)`)\">x</div>", "javascript:")
    f = f + deny(s, "parenthesis-wrapped scheme",
        "<a href=\"(javascript:alert(1))\">x</a>", "javascript:")

    // ...and the counter-check: ordinary relative URLs must still survive,
    // including the ones with a colon AFTER a path separator.
    f = f + keep(s, "relative path kept", "<a href=\"/ok/page\">x</a>", "/ok/page")
    f = f + keep(s, "query with colon kept", "<a href=\"/s?q=a:b\">x</a>", "a:b")
    f = f + keep(s, "fragment with colon kept", "<a href=\"#with:colon\">x</a>", "#with:colon")

    // ---- entity obfuscation without the closing semicolon ----
    // Browsers decode `&#x6a` and `&#0000106` to `j` with no `;`. Requiring
    // the semicolon meant the decoded text never formed `javascript:`, so the
    // scheme check never fired. Named entities stay semicolon-required — the
    // set is open-ended and a bare `&amp` in prose is far more likely literal.
    f = f + deny(s, "hex entities, no semicolons",
        "<IMG SRC=&#x6a&#x61&#x76&#x61&#x73&#x63&#x72&#x69&#x70&#x74&#x3a;alert(1)>", "alert")
    f = f + deny(s, "decimal entities, no semicolons",
        "<IMG SRC=&#0000106&#0000097&#0000118&#0000097script:alert(1)>", "alert")

    // Counter-checks: ordinary ampersands must not be eaten.
    f = f + keep(s, "literal &amp; kept", "<p>Tom &amp; Jerry</p>", "&amp;")
    f = f + keep(s, "bare ampersand kept", "<p>AT&T</p>", "&amp;")
    f = f + keep(s, "hash in prose kept", "<p>issue #123</p>", "#123")

    // ---- URL-list attributes (srcset / ping / archive) ----
    // srcset holds MULTIPLE urls; screening only the first, or treating the
    // whole value as one url, both fail. A bad candidate must be dropped
    // without taking the good ones with it.
    f = f + deny(s, "javascript: candidate in srcset",
        "<img srcset=\"/ok.jpg 1x, javascript:alert(1) 2x\">", "javascript:")
    f = f + deny(s, "payload disguised as a descriptor",
        "<img srcset=\"/ok.jpg javascript:alert(1)\">", "javascript:")

    // ---- expression() / url() obfuscation ----
    // css_value_is_unsafe FOLDS the value before matching, because the naive
    // contains("expression") is trivially evaded. Each of these was live.
    f = f + deny(s, "expression split by css comment",
        "<div style=\"width: e/**/xpression(alert(1))\">x</div>", "xpression")
    f = f + deny(s, "expression via homoglyphs",
        "<div style=\"top: expʀessɪoɴ(alert())\">x</div>", "alert")
    f = f + deny(s, "url via homoglyphs",
        "<div style=\"background-image: uʀʟ(javascript:alert())\">x</div>", "javascript")

    // Counter-checks: legitimate Unicode in CSS must survive the fold.
    f = f + keep(s, "fullwidth font name kept",
        "<div style=\"font-family: 'Ｍｅｉｒｉｏ', sans-serif\">x</div>", "sans-serif")
    f = f + keep(s, "unicode content kept",
        "<div style=\"content: 'café ☃'\">x</div>", "café")

    // ---- attribute-quote breakout ----
    // html_escape stops escaping `'` in attribute values (attributes are
    // always emitted double-quoted, so a single quote cannot terminate one).
    // These pin that reasoning: neither quote form may break out, and an
    // event handler must not materialise from a quote in a value.
    // The property is that no NEW attribute is created — the payload must
    // stay inside the value it was written in. Asserting the absence of
    // "onmouseover=" would be wrong: it legitimately appears INSIDE the
    // title value, inert, and a sanitizer is not required to strip it there.
    // What must never appear is the tag-level form `" onmouseover=`.
    f = f + deny(s, "single quote cannot close an attr",
        "<a title=\"x' onmouseover='alert(1)\">y</a>", "\" onmouseover=")
    f = f + deny(s, "double quote cannot close an attr",
        "<a title='x\" onmouseover=\"alert(1)'>y</a>", "\" onmouseover=")

    // ---- protocol-relative and base-url interactions ----
    f = f + deny_based(s, "javascript: survives base resolution",
        "<a href=\"javascript:alert(1)\">x</a>", "https://example.com", "javascript:")
    f = f + deny_based(s, "data: survives base resolution",
        "<img src=\"data:text/html,<script>alert(1)</script>\">", "https://example.com", "data:text/html")

    htmlsanitizer.free(s)

    // ---- a tightened policy must actually take effect ----
    // The defaults are permissive by design (they mirror the C# library's).
    // The property that matters for a caller who needs more is that removing
    // a tag from the allow-list really removes it, subtree and all.
    strict = htmlsanitizer.new()
    set.remove((strict as *HtmlSanitizer).allowed_tags, "form")
    set.remove((strict as *HtmlSanitizer).allowed_tags, "input")
    f = f + deny(strict, "form removable by policy",
        "<form action=\"//evil.example\"><input></form>", "<form")
    f = f + deny(strict, "input removable by policy",
        "<form action=\"//evil.example\"><input></form>", "<input")
    htmlsanitizer.free(strict)

    // No known gaps: every vector in this file must be blocked.
    known_gaps = 0
    if f > known_gaps {
        println("=== ${f} XSS vector(s) GOT THROUGH (${known_gaps} known) ===")
        exit(1)
    }
    println("=== all XSS vectors blocked ===")
}
