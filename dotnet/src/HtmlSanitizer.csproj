<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The .NET binding over the shared HtmlSanitizer core.

    The sanitizer core is P/Invoked (dlopen'd at run time), not linked, so this project
    has NO build-time dependency on the native library and NO NuGet
    dependencies at all — which is also what lets it build and test on a box
    with no network.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>HtmlSanitization</RootNamespace>
    <AssemblyName>HtmlSanitizer</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      CS1591 "missing XML comment for publicly visible member".

      The idiomatic API (HtmlSanitizer, Node, Attribute, AllowList and the
      handler delegates) IS fully documented, and that is what the generated
      XML is for. The exception is `Native`: it is a 1:1 transcription of the
      C ABI whose members are named exactly after their `aether_hs_embed_*`
      entry points and are collectively documented by the file header. Adding
      thirty one-line summaries restating the entry point name would be noise,
      so the warning is suppressed rather than satisfied mechanically.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      There are no PackageReferences, so restore is a local no-op and `dotnet
      build` never reaches for nuget.org. (Deliberately NOT setting
      RestorePackages=false, which would break the implicit restore that
      `dotnet run` performs and is not the supported way to go offline.)
    -->
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>HtmlSanitizer.Aether</PackageId>
    <Version>0.1.0</Version>
    <Description>
      Clean HTML of constructs that can lead to XSS. A thin P/Invoke binding
      over the shared HtmlSanitizer native sanitizer core — no sanitizer logic lives
      in C#.
    </Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/paul-hammant/html-sanitizer</RepositoryUrl>
  </PropertyGroup>

</Project>
