// Elixir binding tests (ExUnit).
//
// This node builds NO native code. It deps erlang/.build.ae — the canonical
// BEAM NIF — and loads that already-compiled artifact. There is no C source
// and no second .so in elixir/.
//
// THE MIX WRINKLE: erl, escript and gleam all honour $ERL_LIBS, so the Erlang
// and Gleam bindings find the app for free. **Mix does not** — it builds its
// code path from deps/ and _build/, and an OTP app Mix did not build is
// invisible to it. So we pass the app directory in $HTMLSANITIZER_BEAM_APP and
// test/test_helper.exs does Code.append_path on its ebin/.
//
// Conformance checks 10 and 11 (the callback hooks) are NOT covered — a NIF
// cannot synchronously call back into the BEAM, so the shared NIF exposes no
// hooks. See elixir/README.md. The other ten are covered in full.
import bldr
import std.os

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        dep("erlang/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        root = _get("root")
    
        // Skip honestly rather than fail the DAG when the toolchain is absent.
        have = os.system("command -v elixir >/dev/null 2>&1 && command -v mix >/dev/null 2>&1")
        if have != 0 {
            println("elixir: SKIPPED — elixir not installed (no Elixir/Mix on PATH)")
            return 0
        }
    
        // Elixir needs a runtime too; a mix without a working erl cannot boot.
        erl = os.system("command -v erl >/dev/null 2>&1")
        if erl != 0 {
            println("elixir: SKIPPED — erl not installed (Elixir needs Erlang/OTP)")
            return 0
        }
    
        // erlang/.build.ae skips (rather than fails) when erl_nif.h is missing, so
        // the app may legitimately not exist. Without the NIF there is nothing to
        // test, and that is an environment gap, not a binding failure.
        app = "${root}/erlang/_build/htmlsanitizer_nif"
        built = os.system("test -f \"${app}/priv/htmlsanitizer_nif.so\"")
        if built != 0 {
            println("elixir: SKIPPED — the shared BEAM NIF is not built (see erlang/.build.ae)")
            return 0
        }
    
        // MIX_ENV=test keeps the build out of the dev profile. HTMLSANITIZER_LIB
        // points the NIF's loader at the engine artifact wherever aeb put it;
        // priv/ holds a staged copy as the fallback.
        rc = os.system("cd \"${root}/elixir\" && HTMLSANITIZER_BEAM_APP=\"${app}\" HTMLSANITIZER_LIB=\"${lib}\" MIX_ENV=test mix test --no-deps-check")
        if rc != 0 {
            println("elixir: conformance suite reported failures")
            return 1
        }
        println("elixir: PASS — 10-check conformance (10/11 N/A: no NIF callbacks)")
        return 0
    }
}
