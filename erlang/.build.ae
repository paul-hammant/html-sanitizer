// The canonical BEAM binding: ONE NIF, built ONCE, shared by all three BEAM
// languages.
//
// Output: erlang/_build/htmlsanitizer_nif/ — a plain OTP application:
//
//     _build/htmlsanitizer_nif/ebin/htmlsanitizer.beam
//     _build/htmlsanitizer_nif/ebin/htmlsanitizer_nif.beam
//     _build/htmlsanitizer_nif/ebin/htmlsanitizer_nif.app
//     _build/htmlsanitizer_nif/priv/htmlsanitizer_nif.so
//     _build/htmlsanitizer_nif/priv/libhtmlsanitizer.so   (the engine)
//
// elixir/ and gleam/ bldr.dep THIS node and put `erlang/_build` on ERL_LIBS,
// which is how OTP finds an application; they then load the very same
// compiled htmlsanitizer_nif.beam. There is no second copy of the C anywhere
// in the monorepo.
//
// This used to shell out to erlang/build.sh. That script is gone: aeb's
// `erlang.nif` builder now owns the whole job — erl_nif.h discovery via
// `erl`'s own code:root_dir (right for kerl/asdf/Homebrew, not just Debian),
// the deliberate omission of -lhtmlsanitizer from the NIF link line (a
// DT_NEEDED there kills the BEAM inside the dynamic linker instead of
// reporting a clean load error), erlc into ebin/, the verbatim app.src copy,
// and staging the engine into priv/. A missing toolchain is a first-class
// SKIP, counted as such in telemetry.

import bldr
import erlang
import erlang (nif_source, erl_source, app_src, app_name, engine_lib)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
    
        erlang.nif() {
            nif_source("c_src/htmlsanitizer_nif.c")
            erl_source("src/htmlsanitizer_nif.erl")
            erl_source("src/htmlsanitizer.erl")
            app_src("src/htmlsanitizer_nif.app.src")
            app_name("htmlsanitizer_nif")
            // Staged into priv/ so the app is self-contained; the NIF's load
            // callback looks there after $HTMLSANITIZER_LIB.
            engine_lib(lib)
        }
    }
}
