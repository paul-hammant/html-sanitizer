%% rebar3 build for the canonical BEAM binding.
%%
%% This file is for YOU — an Erlang developer who wants this binding inside a
%% normal rebar3/OTP workflow. It is NOT what this monorepo builds with: our
%% own CI drives `aeb erlang/.build.ae` (aeb's erlang.nif builder), because we
%% build 20+ language bindings from one dependency graph. Both produce the same
%% OTP application; neither is a wrapper around the other.
%%
%%     rebar3 compile        % build the NIF + the .beam files
%%     rebar3 ct             % run the conformance suite
%%
%% ---------------------------------------------------------------------------
%% The sanitizer core
%%
%% This binding is a thin NIF over ONE shared native sanitizer core
%% (libhtmlsanitizer.so, pure Aether — see ../core). The sanitizer core is NOT built
%% by rebar3 and is not a rebar dependency; build it once with:
%%
%%     cd ../core && ae build --emit=lib embed.ae --extra _embed_support.c \
%%         -o native/libhtmlsanitizer.so
%%
%% The NIF `dlopen`s it at load time rather than linking it, so the BEAM can
%% load this module even when the sanitizer core is absent and report a clean error
%% instead of dying inside the dynamic linker. Resolution order at run time:
%%   1. $HTMLSANITIZER_LIB
%%   2. priv/ next to this app  (what `make install`-style staging fills in)
%%   3. the OS loader's own search path
%%
%% Deliberately absent from the link line below: -lhtmlsanitizer. Adding it
%% would put a DT_NEEDED on the sanitizer core and defeat the whole arrangement.

{erl_opts, [debug_info]}.

{deps, []}.

%% Build the NIF via rebar3's port compiler.
%%
%% ERL_EI_INCLUDE_DIR/ERTS_INCLUDE_DIR are supplied by rebar3 itself, so
%% erl_nif.h is found for kerl/asdf/Homebrew/relocated installs — not just a
%% distro's /usr/include.
{port_specs, [{"priv/htmlsanitizer_nif.so", ["c_src/*.c"]}]}.

{port_env, [
    {"CFLAGS", "$CFLAGS -std=c11 -Wall -Wextra -fPIC -O2"},
    %% -ldl for dlopen(); macOS has it in libSystem, hence the darwin override.
    {"LDFLAGS", "$LDFLAGS -shared -ldl"},
    {"darwin", "LDFLAGS", "$LDFLAGS -shared -undefined dynamic_lookup"}
]}.

{provider_hooks, [
    {post, [{compile, {pc, compile}}, {clean, {pc, clean}}]}
]}.

{plugins, [pc]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        {ct_opts, [{dir, "test"}]}
    ]}
]}.

{shell, [{apps, [htmlsanitizer_nif]}]}.
