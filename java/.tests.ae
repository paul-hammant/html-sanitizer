// Java binding tests (FFM / Panama, JDK 22+).
//
// The binding classes themselves come from java/.build.ae — the same node the
// kotlin/scala/clojure/groovy layers dep, so the JVM family all compile
// against one set of classes rather than five private copies.
//
// Deliberately NOT java.junit: ConformanceTest is a plain `main` runner with
// no JUnit dependency, so the suite needs nothing but a JDK and cannot fail
// on artifact resolution. `java.junit` globs for *Test.class and drives the
// JUnit console launcher, which would mean vendoring junit + hamcrest to run
// 21 assertions we already express in ~300 lines. The class is written so
// wrapping the checks in @Test is mechanical if that changes.
// java/pom.xml exists for downstream consumers who do want Maven.
//
// Fully idiomatic aeb: javac_test compiles, java_main runs. No os.system, and
// no hand-reconstructed classpath — java_main owns where javac_test writes.
//
// The engine .so is found with NO plumbing here: core/.build.ae is an
// aether.shared_lib, which publishes `ldlibdeps`, and java_main turns that
// into -Djava.library.path. Native.java's platform search then finds
// libhtmlsanitizer.so on it. That is the whole point of the artifact
// contract — one dep edge, no paths in the leaf.
import build
import java
import java (source_layout, jvm_args, skip_below_jdk)

aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    build.dep(b, "java/.build.ae")

    java.javac_test(b) {
        source_layout("maven idiomatic")
    }

    // skip_below_jdk, not min_jdk: FFM is final in JDK 22, and a box with an
    // older JDK should SKIP green rather than fail the line — an
    // under-provisioned node is a fact about the box, not a defect in the
    // binding. min_jdk(22) is the hard form and would FAIL there.
    //
    // --enable-native-access silences the restricted-method warning; without
    // it the JVM only warns today but will fail in a future release.
    java.java_main(b, "org.htmlsanitizer.ConformanceTest") {
        skip_below_jdk(22)
        jvm_args("--enable-native-access=ALL-UNNAMED")
    }
}
