// Kotlin binding tests.
//
// The Kotlin layer is NOT a second FFI: it compiles against the Java binding's
// classes (build.dep java/.build.ae -> "classes_dir") and reaches the engine
// through them. So this node deps BOTH java/.build.ae (for the classpath) and
// core/.build.ae (for the .so that HTMLSANITIZER_LIB points at).
//
// Toolchain note. The suite needs a Kotlin compiler that can READ the Java
// binding's class files. Those are JDK 22+ bytecode, because the FFM API this
// whole monorepo binds through is only available from 22 — so a Kotlin
// compiler older than roughly 1.9 cannot parse them at all (its bundled ASM
// rejects the class-file major version) and the compile fails with
// "Unsupported class file major version". kotlin/find-kotlinc.sh picks the
// newest capable compiler it can find and prints how to run it; if there is
// none, this node SKIPS rather than reporting a false pass.
import build
import std.os

aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    build.dep(b, "java/.build.ae")
    lib = build.dep_artifact(b, "core/.build.ae", "shared_lib")
    classes = build.dep_artifact(b, "java/.build.ae", "classes_dir")
    root = build._get(b, "root")

    out = "${root}/target/.aeb/kotlin-classes"

    rc = os.system("cd \"${root}/kotlin\" && HS_JAVA_CLASSES=\"${classes}\" HS_OUT=\"${out}\" HTMLSANITIZER_LIB=\"${lib}\" ./run-tests.sh")
    if rc == 77 {
        // 77 is this monorepo's "toolchain absent" code, chosen because no
        // compiler or JVM uses it for a real failure.
        println("kotlin: SKIPPED — no Kotlin compiler able to read JDK 22+ bytecode")
        return 0
    }
    if rc != 0 {
        println("kotlin: conformance suite reported failures")
        return 1
    }
    println("kotlin: PASS — 12-check conformance + callback shapes")
    return 0
}
