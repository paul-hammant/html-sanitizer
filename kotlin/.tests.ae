// Kotlin layer: a thin idiomatic wrapper over the JAVA binding's classes —
// there is no second native FFI here. Compile the Kotlin sources against
// those classes, then run the conformance suite.
//
// Replaces a 108-line run-tests.sh. aeb's kotlin SDK owns what that script
// existed for:
//
//   - A real toolchain VETO, not a "is kotlinc on PATH" check. Debian ships
//     kotlinc 1.3, which cannot read the JDK 22+ bytecode this binding needs
//     (the Java layer is FFM/Panama) and only runs under JDK 17 itself. The
//     SDK verifies the compiler rather than trusting PATH, and SKIPs (green,
//     skip-counted) when nothing capable is found.
//   - skip_below_jdk(22) gates the RUN step for the same reason. It is the
//     SOFT floor: a box with only an older JDK is SKIPPED green rather than
//     failing the line. min_jdk(22) is the hard form and would FAIL there —
//     wrong for a portable conformance matrix, where an under-provisioned
//     node is a fact about the box, not a defect in the binding.
//   - kotlin-stdlib on the run classpath, resolved from the SAME install as
//     the verified compiler — a 2.x compiler paired with a stale PATH-kotlinc
//     stdlib is the subtle failure this avoids.
//
// If no capable Kotlin is installed here, point KOTLIN_HOME at one. It must be
// a real kotlinc layout: <home>/bin/kotlinc + <home>/lib/kotlin-stdlib.jar.
// Assembling one from a Gradle distribution's embeddable compiler works, but
// the compiler jar alone is not enough — it also needs kotlinx-coroutines-core-jvm,
// trove4j and annotations alongside the stdlib, or it dies at COMPILE time with
// ClassNotFoundException: kotlinx.coroutines.CoroutineScope, which reads as a
// compiler bug rather than a missing fixture jar.

import bldr
import bldr (dep, dep_artifact, _get)
import std.os
import std.string
// jvm_args lives in lib/java (the JVM-common setters), not lib/kotlin.

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        dep("java/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        root = _get("root")
    
        // Three builders, in order. The classpath comes from java/.build.ae's
        // standard JVM artifact via the dep edge, so nothing is hardcoded.
        //
        // source_layout("maven idiomatic") is required on BOTH compile steps:
        // without it they glob flat in the module root, find nothing, and report
        // "no Kotlin source files found" while returning success.
        // ALL THREE kotlin SDK builders are parked, not rejected. lib/kotlin
        // calls maven.classpath(ctx) at module.ae:300 (kotlinc) and :443
        // (kotlinc_test), and that path derefs an absent `maven_deps` key on a
        // node like ours that declares no maven deps — SEGFAULT, exit 139, no
        // diagnostic. Same root cause as java_main.
        // Filed as aeb/asks/java-main-segfaults-when-node-has-no-maven-deps.md;
        // restore the blocks below when it lands.
        //
        //     kotlin.kotlinc()      { source_layout("maven idiomatic") }
        //     kotlin.kotlinc_test() { source_layout("maven idiomatic") }
        //     kotlin.kotlin_test("org.htmlsanitizer.kotlin.ConformanceTest") {
        //         skip_below_jdk(22)
        //         jvm_args("--enable-native-access=ALL-UNNAMED")
        //         jvm_args("-Dhtmlsanitizer.lib=${lib}")
        //     }
        //
        // KOTLIN_HOME must point at a real kotlinc >= 2.x (Debian ships 1.3.31,
        // which cannot read the JDK 22+ bytecode the FFM-based Java layer emits).
        kh = os.getenv("KOTLIN_HOME")
        if string.length(kh) == 0 {
            println("kotlin: SKIPPED — set KOTLIN_HOME to a kotlinc 2.x install")
            return 0
        }

        classes = dep_artifact("java/.build.ae", "jvm_classpath_deps_including_transitive")
        out = "${root}/target/tests/kotlin/test-classes"
        stdlib = "${kh}/lib/kotlin-stdlib.jar"

        _m = os.system("mkdir -p \"${out}\"")
        rc_c = os.system("cd \"${root}/kotlin\" && \"${kh}/bin/kotlinc\" -nowarn -cp \"${classes}\" -d \"${out}\" $(find src/main/kotlin src/test/kotlin -name '*.kt')")
        if rc_c != 0 {
            println("kotlin: kotlinc failed")
            return 1
        }

        rc = os.system("cd \"${root}/kotlin\" && java --enable-native-access=ALL-UNNAMED \"-Dhtmlsanitizer.lib=${lib}\" -cp \"${classes}:${stdlib}:${out}\" org.htmlsanitizer.kotlin.ConformanceTest")
        if rc != 0 {
            println("kotlin: conformance suite reported failures")
            return 1
        }
        println("kotlin: PASS — 27 checks")
        return 0
    }
}
