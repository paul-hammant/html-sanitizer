// Lua binding: build the C extension and run the conformance suite.
//
// One leaf replaces the old bldr.sh + run_tests.sh pair. aeb's `lua`
// SDK owns the parts that were awkward in shell:
//
//   - Lua 5.4 discovery via pkg-config with header-path fallbacks, and a
//     first-class SKIP (green, skip-counted) when 5.4 is absent entirely.
//   - The Debian-12 case this box actually has: liblua5.4-dev headers are
//     installed but the packaged INTERPRETER is 5.3, which cannot load a 5.4
//     extension. `host_source(...)` builds the small bundled 5.4 host and uses
//     it; the SDK skips that step when a real `lua5.4` binary is on PATH.
//
// The extension `dlopen`s the sanitizer core at run time (it is not on the link line),
// so the sanitizer core path is threaded in via HTMLSANITIZER_LIB — the SDK
// deliberately does not set app-specific env itself.

import bldr
import lua
import lua (c_source, host_source, test_file)
import bldr (env)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
    
        lua.conformance() {
            c_source("src/htmlsanitizer.c")
            // Built ONLY when no lua5.4 interpreter is found; it links liblua
            // because it IS the interpreter, unlike the extension above.
            host_source("host/lua54.c")
            test_file("test/conformance.lua")
            // Output name stays the SDK default, htmlsanitizer_native.so — which
            // is what src/htmlsanitizer.lua's require("htmlsanitizer_native")
            // and LUA_CPATH ./?.so expect. Do not rename without changing both.
            env("HTMLSANITIZER_LIB", lib)
        }
    }
}
