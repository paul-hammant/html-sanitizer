// Python binding tests (ctypes). The loader honors HTMLSANITIZER_LIB, which
// we point at the shared sanitizer core artifact this node deps.
import bldr
import std.os

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        root = _get("root")
    
        // -p no:autoload keeps third-party pytest plugins installed in the
        // developer's site-packages out of the run. Without it, an unrelated
        // broken plugin (a stale anyio/typing_extensions pair, say) fails the
        // suite before a single test of ours executes.
        rc = os.system("cd \"${root}/python\" && HTMLSANITIZER_LIB=\"${lib}\" PYTHONPATH=\"${root}/python\" PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 python3 -m pytest test -q -p no:cacheprovider")
        if rc != 0 {
            println("python: pytest reported failures (is pytest installed?)")
            return 1
        }
        println("python: PASS — 12-check conformance + callback shapes")
        return 0
    }
}
