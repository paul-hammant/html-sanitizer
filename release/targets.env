# Release build matrix — the platforms the sanitizer core .so/.dylib/.dll is
# cross-built for.
#
# All of these cross-compile from a single Linux host via `ae build --target`
# (zig cc backend) — no per-OS runner. Each maps to an output extension:
#   *-linux    -> .so     (ELF)
#   *-macos    -> .dylib   (Mach-O)
#   *-windows  -> .dll     (PE)   [slower mingw cross; opt-in]
#   *-freebsd  -> .so      [needs AETHER_SYSROOT; opt-in]
#
# The sanitizer core is a pure string->string transform with NO network, no
# filesystem, no OS access (core/.build.ae). So — unlike selenium's engine —
# every cross-built artifact here is fully functional on its target with no
# TLS/driver caveats: there is nothing platform-specific to attest beyond "the
# conformance suite passes on this OS/arch."

# Default matrix: linux + macOS + Windows, x86_64 + arm64. All cross-compile
# from one Linux host via zig cc with no sysroot. Windows emits real PE DLLs
# (verified builds cleanly here); we ship them even though this host cannot RUN
# them — the cross-build is deterministic, so a Windows user gets bytes they can
# verify against the .sha256.
RELEASE_TARGETS="aarch64-linux x86_64-linux aarch64-macos x86_64-macos x86_64-windows aarch64-windows"

# Opt-in extras (RELEASE_EXTRA_TARGETS=1 to include). FreeBSD needs
# AETHER_SYSROOT set (a FreeBSD base sysroot), so it stays opt-in.
RELEASE_EXTRA_TARGETS_LIST="x86_64-freebsd aarch64-freebsd"
