// Ruby binding tests (Fiddle). The loader honors HTMLSANITIZER_LIB, which we
// point at the shared sanitizer core artifact this node deps.
import bldr
import std.os

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        root = _get("root")
    
        // rspec is commonly a --user-install gem, whose bin dir is not on PATH by
        // default. Prepend Gem.user_dir/bin so a developer who ran
        // `gem install --user-install rspec` needs no further setup, and fall back
        // to `ruby -S rspec` (which searches the gem paths) if the binstub is
        // still not found.
        rc = os.system("cd \"${root}/ruby\" && PATH=\"$(ruby -e 'print Gem.user_dir')/bin:$PATH\" HTMLSANITIZER_LIB=\"${lib}\" ruby -S rspec --format progress")
        if rc != 0 {
            println("ruby: rspec reported failures (is rspec installed? `gem install --user-install rspec`)")
            return 1
        }
        println("ruby: PASS — 12-check conformance + callback shapes")
        return 0
    }
}
