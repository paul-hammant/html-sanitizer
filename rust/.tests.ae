// Rust binding tests (libloading). The loader honors HTMLSANITIZER_LIB,
// which we point at the shared engine artifact this node deps.
import bldr
import std.os

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        root = _get("root")
    
        // --offline keeps the run reproducible and network-free once libloading
        // is in the local cargo registry cache. Drop it for a first fetch.
        rc = os.system("cd \"${root}/rust\" && HTMLSANITIZER_LIB=\"${lib}\" cargo test --offline")
        if rc != 0 {
            println("rust: cargo test reported failures (is libloading vendored/cached?)")
            return 1
        }
        println("rust: PASS — 12-check conformance + callback shapes")
        return 0
    }
}
