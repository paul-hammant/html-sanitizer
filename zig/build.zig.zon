// Package manifest, so another Zig project can depend on this binding by URL
// or path. There are no `.dependencies` and there never will be: the binding
// needs libc and the sanitizer core .so, neither of which is a Zig package.
//
// A consumer still has to link the sanitizer core itself — a Zig module carries
// source, not link flags. See the README's "Using it from another project".
.{
    // Zig 0.16 requires an enum literal here (it was a string through 0.13).
    .name = .htmlsanitizer,
    .version = "0.1.0",
    // Required since Zig 0.16: a stable per-package id, generated once by zig
    // itself. Do not change it — it is how a consumer's dependency graph
    // identifies this package across renames.
    .fingerprint = 0xb8d56016064ad47f,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "example",
        "README.md",
    },
}
